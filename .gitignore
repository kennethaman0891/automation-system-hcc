# --- secrets (never commit) ---
config/env.php
automation/.env

# --- generated / runtime ---
logs/*.log
logs/*.json
data/state.json
scratch/*
!scratch/.gitkeep

# --- tooling artifacts ---
.playwright-mcp/
automation/node_modules/
node_modules/

# --- large / session artifacts (never commit) ---
storage/whatsapp/ipc/*
!storage/whatsapp/ipc/.gitkeep
storage/whatsapp/media/*
!storage/whatsapp/media/.gitkeep
automation/.whatsapp-session/
automation/.whatsapp-session-test/
automation/admission-ai-service/
automation/rust_engine/
automation/bin/

# --- private runtime data ---
data/private/

# --- dependencies (restored via composer install) ---
vendor/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.old
*.tmp
