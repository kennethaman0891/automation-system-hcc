# HCC WhatsApp Bridge — Environment Configuration Template
# Copy this file to automation/.env and set WHATSAPP_BRIDGE_SECRET
# to match WHATSAPP_BRIDGE_SECRET in config/env.php.
# Never commit automation/.env.

API_BASE_URL=http://127.0.0.1/hcc/admin
WHATSAPP_BRIDGE_SECRET=CHANGE_ME_MATCH_CONFIG_ENV_PHP
HEADLESS=false
POLL_INTERVAL=5000
ENABLE_PRIVACY_FILTER=true
FILTER_REFRESH_INTERVAL=60000
LOG_LEVEL=info
# Optional: override Chrome/Edge path if auto-detection does not find it
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
