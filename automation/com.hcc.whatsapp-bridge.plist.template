<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the HCC WhatsApp bridge LaunchAgent.
  Do not copy this file directly — run:
    ./automation/install-launchd.sh
  which fills __HCC_AUTOMATION_DIR__ and installs to ~/Library/LaunchAgents/.
-->
<plist version="1.0">
<dict>
    <!-- KeepAlive restarts after crash only. Bridge never auto-sends; hub Send press only. -->
    <key>Label</key>
    <string>com.hcc.whatsapp-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HCC_AUTOMATION_DIR__/start-bridge.sh</string>
        <string>--foreground</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HCC_AUTOMATION_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>__HCC_LAUNCHD_LOG__</string>

    <key>StandardErrorPath</key>
    <string>__HCC_LAUNCHD_LOG__</string>
</dict>
</plist>
